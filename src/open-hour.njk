{#- Sessions live in src/_data/openhour.js — add a session there, not here. -#}
{%- import "macros/events.njk" as ev with context %}
{%- set latest = openhour.events[0] %}
{{ ev.hero(
  "// program.open_hour",
  'One topic. One <span class="ink">hour</span>. Online.',
  "Not everything needs a room. Open Hour is a video call around a
            single topic: someone who knows it well leads the conversation,
            then it's questions from everyone on the call, and a chance to
            meet other people in the community.",
  latest.photos.items[0],
  null,
  [
    { href: site.whatsapp, label: "Join the next one on WhatsApp", primary: true }
  ]
) }}

      <!-- ===========================================================
           How an open hour works
           =========================================================== -->
      <section class="section section--program section--openhour reveal" id="how">
        <div class="container">
          <ul class="habits habits--three" aria-label="How an open hour works">
            {%- for h in habits %}
            <li class="habits__item">
              <p class="habits__key">{{ h.key }}</p>
              <h2 class="habits__title">{{ h.title }}</h2>
              <p class="habits__text">{{ h.text }}</p>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </section>

      <!-- ===========================================================
           Open Hour — latest session, then every session.
           =========================================================== -->
      <section class="section section--program section--openhour reveal" id="sessions">
        <div class="container">
{{ ev.feature(latest, openhour.latestLabel) }}

{{ ev.log(openhour.events, openhour.logLabel) }}
        </div>
      </section>
