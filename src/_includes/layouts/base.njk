<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script>
      if (!location.search.includes("static")) {
        document.documentElement.classList.add("js");
      }
      /* Event photos get dropped into assets/Events/… after the markup for
         a new edition goes up, so a slot can legitimately sit empty for a
         few days. Hide the missing image so the tinted "photos coming"
         placeholder behind it shows through, instead of a torn-image icon
         and sprawling alt text. Must be registered here rather than in
         main.js — deferred scripts run after images have already failed. */
      document.addEventListener(
        "error",
        function (e) {
          if (e.target && e.target.tagName === "IMG") {
            e.target.style.visibility = "hidden";
          }
        },
        true
      );
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="color-scheme" content="light" />

    {%- set pageUrl = site.url + (canonical or page.url | replace(".html", "")) %}
    {%- set ogImage = site.url + "/" + (ogImage or "assets/og-image.png") %}

    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <link rel="canonical" href="{{ pageUrl }}" />

    <!-- Open Graph / social link previews (absolute URLs required) -->
    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="SwiftPune" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ ogDescription or description }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    {%- if not ogImage or ogImage.endsWith("og-image.png") %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {%- endif %}
    <meta property="og:image:alt" content="{{ ogAlt or title }}" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ ogDescription or description }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />

    <link rel="icon" type="image/svg+xml" href="assets/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="assets/SPLogo.png" />
    <link rel="apple-touch-icon" href="assets/SPLogo.png" />

    <link rel="preload" as="image" href="assets/SPLogo.png" fetchpriority="high" />

    <link rel="stylesheet" href="css/reset.css" />
    <link rel="stylesheet" href="css/tokens.css" />
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

{% include "partials/nav.njk" %}

    <main id="main">
{{ content | safe }}
{%- if connect !== false %}
{% include "partials/connect.njk" %}
{%- endif %}
    </main>

{% include "partials/footer.njk" %}

    <script src="js/main.js" defer></script>
  </body>
</html>
